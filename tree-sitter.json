{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tauraro",
      "camelcase": "Tauraro",
      "title": "Tauraro",
      "scope": "source.tauraro",
      "file-types": [
        "tauraro",
        "tr",
        "tau"
      ],
      "injection-regex": "^tauraro$",
      "class-name": "TreeSitterTauraro"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter parser for the Tauraro language",
    "authors": [
      {
        "name": "ken-morel",
        "email": "me@engon.cm",
        "url": "https://engon.cm"
      }
    ],
    "links": {
      "repository": "https://github.com/dev-safe/tree-sitter-tauraro",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": true
  }
}